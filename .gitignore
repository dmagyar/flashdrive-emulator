# Build output - regenerated by build.sh, ~175 MB, never useful in history.
build/

# sdkconfig is GENERATED. build.sh runs `idf.py set-target`, which DELETES sdkconfig and rebuilds it
# from sdkconfig.defaults - so the only config input that is real is sdkconfig.defaults. Tracking the
# generated file would produce a 96 KB diff on every knob change and hide the fact that a knob edit
# never took effect (which cost a whole false conclusion once).
sdkconfig
sdkconfig.old
sdkconfig.*.old

# Bench-local secrets and scratch. Wi-Fi/SMB credentials live in NVS on the device and in
# /root/.smbcreds on HermesBoard - deliberately never in this repo.
*.local.cfg
.smbcreds*
prov*.txt
*.pem
*.key
*.pub.gpg

# Host-side probe binaries compiled by tools/run_*.sh (sources are tracked, outputs are not).
tools/negprobe
tools/readstall_probe
tools/interleave_probe
tools/test_smb_path
tools/*.o
*.part

# A/B arm images and per-arm build dirs (tools/ba_win_build.sh).
dist/
build-*/
